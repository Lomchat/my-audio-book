# MyAudioBook configuration. Copy to `.env` and edit.
# Every variable is optional except LLM_API_KEY (needed for summaries, sorting and chat).

# --- General -------------------------------------------------------------------
APP_NAME=MyAudioBook
# Public address of your instance (used in emails and for Google sign-in).
PUBLIC_URL=http://localhost:8000
# Other addresses serving the same app (e.g. a Cloudflare Worker), comma-separated.
EXTRA_ORIGINS=
GITHUB_URL=https://github.com/Lomchat/my-audio-book

# --- Summaries, sorting and chat: any OpenAI-compatible API ----------------------
# OpenRouter (default): create a key at https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# OpenRouter only: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=low
# Fully local alternative with Ollama (no key needed):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3:8b

# --- Accounts & limits -----------------------------------------------------------
ALLOW_SIGNUP=true
# Free audio minutes per account, lifetime (-1 = unlimited).
# Raise it for someone: python -m app.manage quota EMAIL MINUTES|unlimited|default
FREE_QUOTA_MINUTES=5
# Shown when someone runs out of minutes (e.g. https://wa.me/15551234567 or mailto:you@example.com)
CONTACT_URL=
MAX_UPLOAD_MB=100
MAX_AUDIO_MINUTES=180
# Chat messages + regenerated summaries per user per day (-1 = unlimited)
AI_DAILY_LIMIT=50

# --- Google sign-in (optional) ---------------------------------------------------
# Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback (and one per EXTRA_ORIGINS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transcription (runs locally on CPU) ----------------------------------------
# large-v3-turbo (default, ~1.6 GB) | large-v3 | medium | small | any faster-whisper repo on Hugging Face
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=8
WHISPER_BEAM_SIZE=5
# Languages the detector may pick from (users can also force one at upload)
LANGUAGES=fr,he,en

# --- Speaker diarization ("who spoke when") --------------------------------------
DIARIZATION=true
# Lower = more speakers are told apart, higher = more merging
DIARIZATION_THRESHOLD=0.5

# --- Email for password reset (optional, any SMTP server) -------------------------
# Resend example: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SSL=true SMTP_USER=resend SMTP_PASSWORD=re_xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker Compose -------------------------------------------------------------
# PORT=8000
# BIND_ADDRESS=127.0.0.1   (0.0.0.0 to expose on your network without a reverse proxy)
# DATA_PATH=./data         (default: a named Docker volume)
# WORKER_CPUS=8
