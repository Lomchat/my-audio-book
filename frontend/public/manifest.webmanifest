{
  "name": "MyAudioBook",
  "short_name": "MyAudioBook",
  "description": "Transcripts, summaries, to-dos and sorting for your audio.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf6ec",
  "theme_color": "#fbf6ec",
  "icons": [
    { "src": "/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png?v=2", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg?v=2", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["audio/*", "video/*", ".m4a", ".amr", ".3gp", ".opus", ".ogg", ".wav", ".mp3", ".aac", ".webm", ".flac"]
        }
      ]
    }
  }
}
